{
  "name": "orbit-workspaces",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "test": "tsx --test --test-concurrency=1 server/tests/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongodb-memory-server": "^10.2.3",
    "mongoose": "^8.19.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.10",
    "smtp-server": "^3.21.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
