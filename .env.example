# No configuration is needed for local development.
# Production must use its own MongoDB replica set and a secret of at least 32 characters.
# NODE_ENV=production
# PORT=4173
# APP_ORIGIN=https://your-app.example.com
# MONGODB_URI=mongodb+srv://...
# JWT_SECRET=replace-with-a-long-random-secret

# Local defaults: private captured email, persistent files in .local/uploads, one app server.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=Orbit <invitations@example.com>
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# STARTTLS is required for non-secure SMTP connections. Port 465 uses SMTP_SECURE=true.

# Optional private S3 storage (otherwise UPLOAD_DIRECTORY must be persistent in production).
# S3_BUCKET=your-private-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-server-access-key
# AWS_SECRET_ACCESS_KEY=your-server-secret
# S3_ENDPOINT=https://your-compatible-s3-endpoint
# UPLOAD_DIRECTORY=D:/orbit-data/uploads

# Optional Socket.IO multi-server adapter. Use a dedicated authenticated Redis service.
# REDIS_URL=rediss://user:password@your-redis-host:6379
